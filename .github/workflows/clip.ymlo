name: Clip

on:
  workflow_dispatch:
    inputs:
      url:
        required: true
        type: string
      start:
        required: true
        type: string
      end:
        required: true
        type: string
      quality:
        description: Video quality
        required: false
        default: '1080'
        type: choice
        options:
          - '720'
          - '1080'
          - '1440'
          - '2160'
      short:
        description: Create vertical short
        required: false
        default: 'no'
        type: choice
        options:
          - 'no'
          - 'yes'
      channel_id:
        required: true
        type: string

permissions:
  contents: write

jobs:
  clip:
    runs-on: ubuntu-latest
    timeout-minutes: 90

    env:
      URL: ${{ inputs.url }}
      START: ${{ inputs.start }}
      END: ${{ inputs.end }}
      Q: ${{ inputs.quality }}
      SHORT: ${{ inputs.short }}
      CH: ${{ inputs.channel_id }}
      BOT: ${{ secrets.DISCORD_BOT_TOKEN }}
      COOKIES: ${{ secrets.YT_COOKIES }}
      GH_TOKEN: ${{ github.token }}
      GH_REPO: ${{ github.repository }}

    steps:
      - name: Validate
        shell: bash
        run: |
          set -euo pipefail

          [[ "$URL" =~ ^https://(www\.|m\.)?(youtube\.com|youtu\.be)/ ]] || {
            echo "Invalid YouTube URL"
            exit 1
          }

          [[ "$START" =~ ^[0-9:]+$ && "$END" =~ ^[0-9:]+$ ]] || {
            echo "Invalid timestamp"
            exit 1
          }

          [[ "$Q" =~ ^(720|1080|1440|2160)$ ]]
          [[ "$SHORT" =~ ^(yes|no)$ ]]

      - name: Install tools
        shell: bash
        run: |
          set -e
          sudo apt-get update -y
          sudo apt-get install -y ffmpeg jq
          python -m pip install -U "yt-dlp[default]"

      - name: Download section
        shell: bash
        run: |
          set -euo pipefail

          COOKIE_ARGS=()

          if [ -n "${COOKIES:-}" ]; then
            printf '%s' "$COOKIES" > cookies.txt
            COOKIE_ARGS=(--cookies cookies.txt)
          fi

          yt-dlp \
            "${COOKIE_ARGS[@]}" \
            --js-runtimes node \
            --remote-components ejs:github \
            --download-sections "*${START}-${END}" \
            --no-part \
            --retries 3 \
            --fragment-retries 3 \
            --concurrent-fragments 4 \
            -f "bv*[height<=${Q}]+ba/b[height<=${Q}]" \
            --merge-output-format mp4 \
            -o "raw.%(ext)s" \
            "$URL"

          rm -f cookies.txt

      - name: Check and convert video
        shell: bash
        run: |
          set -euo pipefail
          shopt -s nullglob
          FILES=(raw.*)

          if [ ${#FILES[@]} -eq 0 ]; then
            echo "No downloaded video found"
            exit 1
          fi

          IN="${FILES[0]}"

          VIDEO_CODEC=$(ffprobe -v error \
            -select_streams v:0 \
            -show_entries stream=codec_name \
            -of default=noprint_wrappers=1:nokey=1 "$IN" | head -1)

          PIX_FMT=$(ffprobe -v error \
            -select_streams v:0 \
            -show_entries stream=pix_fmt \
            -of default=noprint_wrappers=1:nokey=1 "$IN" | head -1)

          AUDIO_CODEC=$(ffprobe -v error \
            -select_streams a:0 \
            -show_entries stream=codec_name \
            -of default=noprint_wrappers=1:nokey=1 "$IN" | head -1 || true)

          WIDTH=$(ffprobe -v error \
            -select_streams v:0 \
            -show_entries stream=width \
            -of default=noprint_wrappers=1:nokey=1 "$IN" | head -1)

          HEIGHT=$(ffprobe -v error \
            -select_streams v:0 \
            -show_entries stream=height \
            -of default=noprint_wrappers=1:nokey=1 "$IN" | head -1)

          echo "Input: $IN"
          echo "Video codec: $VIDEO_CODEC"
          echo "Pixel format: $PIX_FMT"
          echo "Audio codec: ${AUDIO_CODEC:-none}"
          echo "Resolution: ${WIDTH}x${HEIGHT}"

          # Vertical shorts require cropping and rendering.
          if [ "$SHORT" = "yes" ]; then
            ffmpeg -y -fflags +genpts -i "$IN" \
              -map 0:v:0 -map "0:a:0?" \
              -vf "crop=ih*9/16:ih,scale=1080:1920:flags=lanczos,setsar=1,format=yuv420p" \
              -c:v libx264 -preset veryfast -crf 20 \
              -c:a aac -b:a 192k -ar 48000 \
              -af "aresample=async=1:first_pts=0" \
              -avoid_negative_ts make_zero \
              -movflags +faststart \
              clip.mp4

          # Standard H.264, yuv420p and AAC can use fast stream copy.
          elif [ "$VIDEO_CODEC" = "h264" ] && \
               [ "$PIX_FMT" = "yuv420p" ] && \
               { [ "$AUDIO_CODEC" = "aac" ] || [ -z "$AUDIO_CODEC" ]; }; then

            echo "Compatible streams found. Trying fast copy."

            if ! ffmpeg -y -fflags +genpts -i "$IN" \
              -map 0:v:0 -map "0:a:0?" \
              -c copy \
              -avoid_negative_ts make_zero \
              -movflags +faststart \
              clip.mp4; then

              echo "Copy failed. Re-encoding."
              rm -f clip.mp4

              ffmpeg -y -fflags +genpts -i "$IN" \
                -map 0:v:0 -map "0:a:0?" \
                -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2,setsar=1,format=yuv420p" \
                -c:v libx264 -preset veryfast -crf 20 \
                -c:a aac -b:a 192k -ar 48000 \
                -af "aresample=async=1:first_pts=0" \
                -avoid_negative_ts make_zero \
                -movflags +faststart \
                clip.mp4
            fi

          else
            echo "Incompatible streams found. Converting to standard MP4."

            ffmpeg -y -fflags +genpts -i "$IN" \
              -map 0:v:0 -map "0:a:0?" \
              -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2,setsar=1,format=yuv420p" \
              -c:v libx264 -preset veryfast -crf 20 \
              -c:a aac -b:a 192k -ar 48000 \
              -af "aresample=async=1:first_pts=0" \
              -avoid_negative_ts make_zero \
              -movflags +faststart \
              clip.mp4
          fi

          test -s clip.mp4

          echo "Final output:"
          ffprobe -v error \
            -show_entries format=format_name,duration \
            -show_entries stream=codec_type,codec_name,pix_fmt,width,height \
            -of json clip.mp4

      - name: Upload to Release
        shell: bash
        run: |
          set -euo pipefail

          TAG="clip-${GITHUB_RUN_ID}"

          gh release create "$TAG" clip.mp4 \
            --title "clip" \
            --notes ""

      - name: Send link to Discord
        shell: bash
        run: |
          set -euo pipefail

          LINK="https://github.com/${GH_REPO}/releases/download/clip-${GITHUB_RUN_ID}/clip.mp4"

          jq -n --arg c "✅ Clip ready: $LINK" '{content:$c}' |
          curl --fail-with-body -sS \
            -X POST \
            -H "Authorization: Bot $BOT" \
            -H "Content-Type: application/json" \
            -d @- \
            "https://discord.com/api/v10/channels/$CH/messages"

      - name: Cleanup old clips
        shell: bash
        run: |
          gh release list --limit 100 --json tagName \
            -q '.[10:][].tagName' |
          xargs -r -I{} gh release delete {} --cleanup-tag -y

      - name: Tell Discord if failed
        if: failure()
        shell: bash
        run: |
          if [ -n "${CH:-}" ] && [ -n "${BOT:-}" ]; then
            jq -n '{content:"❌ Clip fail ho gayi. GitHub Actions logs mein error check karo."}' |
            curl -sS \
              -X POST \
              -H "Authorization: Bot $BOT" \
              -H "Content-Type: application/json" \
              -d @- \
              "https://discord.com/api/v10/channels/$CH/messages" || true
          fi
